    "@lindauria/design-system": "workspace:*",
    "@lindauria/input-engine": "workspace:*",
    "@lindauria/keyboards": "workspace:*",
    "@lindauria/safety": "workspace:*",
    "@lindauria/shared": "workspace:*",
    "@lindauria/voice": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.21",
    "framer-motion": "^12.16.0",
    "jspdf": "^3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@tailwindcss/vite": "^4.1.8",
