# ===== LindaurIA — variáveis de ambiente =====
# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo .env NUNCA vai para o celular nem para o Git: a chave fica só neste computador.

# --- Chat LindaurIA e Câmera Inteligente (IA) ---
# Crie a chave em https://console.anthropic.com → API Keys.
# Modelo usado: claude-opus-5-5 (US$ 4 por milhão de tokens de entrada, US$ 20 de saída).
# Custo aproximado: ~US$ 0,01 a 0,03 por pergunta do chat e ~US$ 0,02 a 0,04 por foto.
ANTHROPIC_API_KEY=

# --- Próximas fases (ainda não usadas) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_API_TOKEN=
ELEVENLABS_API_KEY=
